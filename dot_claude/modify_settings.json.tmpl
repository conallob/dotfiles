#!/bin/bash
# chezmoi modify script for ~/.claude/settings.json.
#
# Claude Code rewrites this file itself (permissions, plugins it installs,
# changes made with /config, ...), so chezmoi manages only part of it and leaves
# the rest as the app wrote it. chezmoi feeds the current file on stdin and
# takes the new contents from stdout.
#
# - enabledPlugins, extraKnownMarketplaces and env: the managed entries are
#   merged over the live ones. A managed entry wins on conflict; entries added
#   by hand or by the app are kept.
# - hooks: each event listed below is replaced by the managed list, and events
#   not listed here are kept.
# - $schema and alwaysThinkingEnabled: set only when the file has no value, so
#   a change made in the app sticks.
# - Removing an entry from this file does NOT remove it from the live file;
#   delete it there by hand.
#
# https://www.chezmoi.io/user-guide/manage-different-types-of-file/#manage-part-but-not-all-of-a-file
set -euo pipefail

MANAGED=$(mktemp)
trap 'rm -f "$MANAGED"' EXIT

cat > "$MANAGED" << 'MANAGEDEOF'
{
  "enabledPlugins": {
    {{- /* Github API plugin */}}
    "github@claude-plugins-official": true,
    {{- /* LSP Servers */}}
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    {{- /* Git Commit Commands */}}
    "commit-commands@claude-plugins-official": true,
    {{- /* Obsidian Skills */}}
    "obsidian@obsidian": true,
    {{- /* SRE Alerting Guidelines */}}
    "sre-alerting-guidelines@conallob": true,
    {{- /* o11y-analysis-tools: PromQL/Alertmanager skills */}}
    "promql-cody@o11y-analysis-tools": true
  },
  "extraKnownMarketplaces": {
{{ includeTemplate "dot_claude/skill-marketplaces-common.json.tmpl" . | trim | indent 4 }}
{{- if eq (includeTemplate "isWorkAccount" .) "true" }},
{{ includeTemplate "dot_claude/skill-marketplaces-work.json.tmpl" . | trim | indent 4 }}
{{- end }}
  },
  "env": {
    {{- /* Git identity for commits made by Claude */}}
    {{- $isWork := eq (includeTemplate "isWorkAccount" .) "true" }}
    "GIT_AUTHOR_NAME": "Conall O'Brien",
    "GIT_AUTHOR_EMAIL": "conall@{{ if $isWork }}andromeda.ai{{ else }}conall.net{{ end }}",
    "GIT_COMMITTER_EMAIL": "conall@{{ if $isWork }}andromeda.ai{{ else }}conall.net{{ end }}"
  },
  "hooks": {
    {{- /* Native system notifications when Claude is waiting for input */}}
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            {{- /* macOS native notification with Claude app icon */}}
            "command": "terminal-notifier -message \"Claude has completed the task and is awaiting your input\" -title \"Claude Code\" -sender com.anthropic.claudefordesktop"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            {{- /* Alert when Claude needs permission with Claude app icon */}}
            "command": "terminal-notifier -message \"Claude needs your permission to proceed\" -title \"Claude Code\" -sender com.anthropic.claudefordesktop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            {{- /* Terminal bell when Claude finishes responding */}}
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    {{- /* Re-inject CLAUDE.md after context compaction to restore critical instructions */}}
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context compacted. Re-read ~/.claude/CLAUDE.md and the project CLAUDE.md (if present) to restore critical instructions before continuing.'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  }
}
MANAGEDEOF

INPUT=$(cat)
[ -z "$INPUT" ] && INPUT="{}"
echo "$INPUT" | jq --indent 2 \
  --slurpfile managed "$MANAGED" \
  '$managed[0] as $m
   | {"$schema": "https://json.schemastore.org/claude-code-settings.json", "alwaysThinkingEnabled": false} + .
   | .enabledPlugins = ((.enabledPlugins // {}) + $m.enabledPlugins)
   | .extraKnownMarketplaces = ((.extraKnownMarketplaces // {}) + $m.extraKnownMarketplaces)
   | .env = ((.env // {}) + $m.env)
   | .hooks = ((.hooks // {}) + $m.hooks)'
