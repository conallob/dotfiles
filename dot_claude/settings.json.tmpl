{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": false,
  "enabledPlugins": {
    {{- /* Github API plugin */}}
    "github@claude-plugins-official": true,
    {{- /* LSP Servers */}}
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    {{- /* Git Commit Commands */}}
    "commit-commands@claude-plugins-official": true,
    {{- /* Obsidian Skills */}}
    "obsidian@obsidian-skills": true,
    {{- /* SRE Alerting Guidelines */}}
    "sre-alerting-guidelines@conallob": true,
    {{- /* o11y-analysis-tools: PromQL/Alertmanager skills */}}
    "promql-cody@o11y-analysis-tools": true
  },
  "extraKnownMarketplaces": {
    "conallob": {
      "source": {
        "source": "github",
        "repo": "conallob/SRE-Alerting-Guidelines"
      }
    },
    "o11y-analysis-tools": {
      "source": {
        "source": "github",
        "repo": "conallob/o11y-analysis-tools"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "dietrichgebert/ponytail"
      }
    },
    "superpowers": {
      "source": {
        "source": "github",
        "repo": "smartwatermelon/superpowers-marketplace"
      }
    },
    "beads": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    }
  },
  "env": {
    {{- /* Env vars (git identity for commits made by Claude) come from cloud/bashenv.claude-ai */}}
    {{- $isWork := eq (includeTemplate "isWorkAccount" .) "true" }}
    {{- $pairs := list }}
    {{- range $line := splitList "\n" (include "cloud/bashenv.claude-ai") }}
    {{- if regexMatch `^export [A-Z_]+="` $line }}
    {{- $key := regexReplaceAll `^export ([A-Z_]+)=.*$` $line "${1}" }}
    {{- $value := regexReplaceAll `^export [A-Z_]+="(.*)"$` $line "${1}" }}
    {{- if $isWork }}{{ $value = replace "@conall.net" "@andromeda.ai" $value }}{{ end }}
    {{- $pairs = append $pairs (printf "%s: %s" (toJson $key) (toJson $value)) }}
    {{- end }}
    {{- end }}
    {{ join ",\n    " $pairs }}
  },
  "hooks": {
    {{- /* Native system notifications when Claude is waiting for input */}}
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            {{- /* macOS native notification with Claude app icon */}}
            "command": "terminal-notifier -message \"Claude has completed the task and is awaiting your input\" -title \"Claude Code\" -sender com.anthropic.claudefordesktop"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            {{- /* Alert when Claude needs permission with Claude app icon */}}
            "command": "terminal-notifier -message \"Claude needs your permission to proceed\" -title \"Claude Code\" -sender com.anthropic.claudefordesktop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            {{- /* Terminal bell when Claude finishes responding */}}
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    {{- /* Re-inject CLAUDE.md after context compaction to restore critical instructions */}}
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context compacted. Re-read ~/.claude/CLAUDE.md and the project CLAUDE.md (if present) to restore critical instructions before continuing.'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
