# skhd hotkey config — https://github.com/koekeishiya/skhd
#
# F13/F14/F15 are sent by the "OmniFocus" layer (layer #3) on the
# Keyboardio Model 100 — see Chrysalis_Keyboardio-Model-100_layout.json
# and Chrysalis_Keyboardio-Model-100_layout.schema.md at the repo root.
# Nothing else on this Mac uses F13-F15, so they're safe as dedicated
# triggers.
#
# The AppleScript itself lives in conallob/omnifocus-scripts
# (reschedule-selection/reschedule_selection.applescript), installed via
# the conallob/tap Homebrew tap (see Brewfile.tmpl) and found below
# through `brew --prefix`.

# Reschedule the selected OmniFocus item(s) to today
f13 : osascript "$(brew --prefix)/share/omnifocus-scripts/reschedule-selection/reschedule_selection.applescript" today

# Reschedule the selected OmniFocus item(s) to tomorrow
f14 : osascript "$(brew --prefix)/share/omnifocus-scripts/reschedule-selection/reschedule_selection.applescript" tomorrow

# Reschedule the selected OmniFocus item(s) to the next working day
# (skips Saturday/Sunday)
f15 : osascript "$(brew --prefix)/share/omnifocus-scripts/reschedule-selection/reschedule_selection.applescript" next-workday
