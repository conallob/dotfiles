{{- /* Personal (conall@gmail.com) hosts only — renders empty, and so is skipped, on work hosts */ -}}
{{- if ne (includeTemplate "isWorkAccount" .) "true" -}}
#!/bin/bash
# Registers Google's remote Workspace MCP servers (Docs, Sheets) with Claude Code.
#
# The OAuth client lives in GCP project agentic-workspace-hooks; its client ID
# and secret are stored in the 1Password item google-workspace-mcp-oauth
# (username = client ID, credential = client secret).
#
# These servers are registered via `claude mcp add-json` rather than the
# mcp-servers-*.json.tmpl partials, because Claude Code keeps an OAuth
# client secret in the system keychain, never in ~/.claude.json.
#
# Re-runs whenever the OAuth client changes:
#   client secret sha256: {{ (onepasswordDetailsFields "google-workspace-mcp-oauth").credential.value | sha256sum }}
set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "google-workspace-mcp: claude not installed, skipping" >&2
  exit 0
fi

CLIENT_ID='{{ (onepasswordDetailsFields "google-workspace-mcp-oauth").username.value }}'
# Must match the http://localhost:<port>/callback redirect URI on the OAuth client
CALLBACK_PORT=38917

MCP_CLIENT_SECRET=$(op item get google-workspace-mcp-oauth --fields label=credential --reveal)
export MCP_CLIENT_SECRET

DRIVE_SCOPES="https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file"

add_server() {
  local name="$1" url="$2" scopes="$3"
  claude mcp remove --scope user "$name" >/dev/null 2>&1 || true
  claude mcp add-json --scope user --client-secret "$name" "$(jq -n \
    --arg url "$url" --arg id "$CLIENT_ID" --argjson port "$CALLBACK_PORT" --arg scopes "$scopes" \
    '{type: "http", url: $url, oauth: {clientId: $id, callbackPort: $port, scopes: $scopes}}')"
}

add_server google-docs https://docsmcp.googleapis.com/mcp/v1 \
  "$DRIVE_SCOPES https://www.googleapis.com/auth/documents.readonly https://www.googleapis.com/auth/documents"
add_server google-sheets https://sheetsmcp.googleapis.com/mcp/v1 \
  "$DRIVE_SCOPES https://www.googleapis.com/auth/spreadsheets.readonly https://www.googleapis.com/auth/spreadsheets"

echo "google-workspace-mcp: run /mcp in Claude Code to authenticate google-docs and google-sheets"
{{ end -}}
