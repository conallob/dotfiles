# Environment variables for Claude sessions, sourced from ~/.bashrc by cloud/setup.sh.
# dot_claude/settings.json.tmpl also reads the `export KEY="value"` lines below into its "env"
# block (and swaps conall.net for andromeda.ai on work machines), so keep that exact form.
# No other templating here: the cloud VM has no chezmoi.
export GIT_AUTHOR_NAME="Conall O'Brien"
export GIT_AUTHOR_EMAIL="conall@conall.net"
export GIT_COMMITTER_EMAIL="conall@conall.net"
