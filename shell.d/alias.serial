# vim: filetype=sh

# Open a serial console with screen.
#   serial [DEVICE] [BAUD]
# With no DEVICE, lists the serial devices found and prompts for one.
# BAUD defaults to 115200.
serial() {
  serial_device="$1"
  serial_baud="${2:-115200}"

  if [ -z "$serial_device" ]; then
    # find rather than a glob, so zsh doesn't error out on no matches.
    case "$(uname -s)" in
      Darwin) serial_candidates=$(find /dev -maxdepth 1 -name 'tty.usbserial*' | sort) ;;
      *)      serial_candidates=$(find /dev -maxdepth 1 \( -name 'ttyAMA*' -o -name 'ttyUSB*' \) | sort) ;;
    esac
    if [ -z "$serial_candidates" ]; then
      echo "serial: no serial devices found" >&2
      return 1
    fi

    echo "Serial devices:"
    echo "$serial_candidates" | awk '{ printf "  %d) %s\n", NR, $0 }'
    printf "Select device [1]: "
    read -r serial_choice
    serial_device=$(echo "$serial_candidates" | sed -n "${serial_choice:-1}p")
    if [ -z "$serial_device" ]; then
      echo "serial: invalid selection" >&2
      return 1
    fi
  fi

  sudo screen "$serial_device" "$serial_baud"
}
