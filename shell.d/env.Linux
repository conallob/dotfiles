# vim: filetype=sh

# 1Password Connect server in the homelab. chezmoi's onepassword functions
# (mode = "connect", see dot_config/chezmoi/chezmoi.toml.tmpl) and the `op` CLI
# read this. OP_CONNECT_TOKEN is deliberately not set here: export it from
# outside the repo (e.g. ~/.config/op/connect-token sourced from a private file).
export OP_CONNECT_HOST="https://onepassword-connect.tail8c390c.ts.net"
