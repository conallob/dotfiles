{{- $keyVault := "jyacovhjsr2d4jjrgeomtzyuzm" -}}
{{- $keyAccount := "JD7WAP3FNZG4DDJPRBYAEG5VJM" -}}
{{- if $isWork }}
{{- $keyItem = "g6hke7hirfckny5oepuatf5p2i" }}
{{- $keyVault = "ioy74udpo4odjq3ecjx2cekpti" }}
