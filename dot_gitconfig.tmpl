{{- $keyAccount := "JD7WAP3FNZG4DDJPRBYAEG5VJM" -}}
{{- $keyItem := "r74joco2pgzyvl7dkywtbqkt6a" -}}
{{- $keyVault := "jyacovhjsr2d4jjrgeomtzyuzm" -}}
{{- if $isWork }}
{{- $keyItem = "c2svjoybrux4yu62ihcarwdf7e" }}
{{- $keyVault = "way3jp7pq3o64cew37dm7w3hbe" }}
