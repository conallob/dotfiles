[user]
	signingkey = {{ (index (onepasswordDetailsFields $keyItem $keyVault $keyAccount) "public_key").value }}
	email = conall@{{ if $isWork }}andromeda.ai{{ else }}conall.net{{ end }}

[gpg]
	format = ssh

{{- if eq .chezmoi.os "darwin" }}

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}

[commit]
	gpgsign = true

{{- if eq .chezmoi.os "darwin" }}

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- end }}
